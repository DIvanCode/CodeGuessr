# Copy to .env on the deployment server and edit the values there.
# Required for public HTTPS: DNS A/AAAA records must point to this server.
# Use a hostname only (without https:// or trailing slash).
# localhost is only suitable for local testing and uses a locally trusted CA.
DOMAIN=localhost

# Optional. Public GitHub data works without a token (60 API requests/hour/IP).
# For a higher rate limit, use a fine-grained read-only GitHub personal access token.
# Never commit the real token, put it in frontend code or paste it into logs.
GITHUB_TOKEN=
